{
  "id": "dev.senn.local-vault",
  "name": "Local Vault",
  "version": "0.1.0",
  "description": "Stores user-selected files locally and ships them P2P (≤ 64 KiB single-frame) to the connected peer.",
  "entry": "index.html",
  "license": "Apache-2.0",
  "author": "SENN Project",
  "network": false,
  "permissions": [
    "storage.local.read",
    "storage.local.write",
    "file.read.user_selected",
    "file.write.user_approved",
    "peer.send.bin",
    "peer.receive.bin",
    "ui.panel"
  ],
  "capabilities": ["local-vault-v1"]
}
