{
  "name": "senn",
  "version": "0.0.0",
  "private": true,
  "description": "SENN — open-source browser-native P2P runtime for static add-ons.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/20m61/senn",
  "repository": {
    "type": "git",
    "url": "https://github.com/20m61/senn.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "addons/official/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @senn/web dev",
    "test": "pnpm -r --if-present test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b --pretty",
    "validate:addon": "tsx scripts/validate-addon-manifest.ts",
    "check:licenses": "tsx scripts/check-licenses.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
