{
  "name": "senn",
  "version": "0.0.0",
  "private": true,
  "description": "SENN — open-source browser-native P2P runtime for static add-ons.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/20m61/senn",
  "repository": {
    "type": "git",
    "url": "https://github.com/20m61/senn.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @senn/web dev",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b --pretty",
    "validate:addon": "tsx scripts/validate-addon-manifest.ts",
    "validate:all-manifests": "tsx scripts/validate-all-manifests.ts",
    "validate:invite": "tsx scripts/validate-invite.ts",
    "validate:bundle": "tsx scripts/validate-bundle.ts",
    "check:addon-forbidden": "tsx scripts/check-addon-forbidden-apis.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "sign:manifest": "tsx scripts/sign-manifest.ts",
    "verify:manifest": "tsx scripts/verify-manifest.ts",
    "verify:official": "tsx scripts/verify-official-addons.ts",
    "verify:addon-sdk": "tsx scripts/verify-addon-sdk.ts",
    "validate:registry": "tsx scripts/validate-registry.ts",
    "test:registry-schema": "tsx --test scripts/test-registry-schema.ts",
    "sign:all-official": "tsx scripts/sign-all-official.ts",
    "build:addon-sdk": "tsx scripts/build-addon-sdk.ts",
    "build:web-registry": "tsx scripts/build-web-registry.ts",
    "stage:gallery-pages": "tsx scripts/stage-gallery-pages.ts",
    "verify:http-poll-endpoint": "tsx scripts/verify-http-poll-endpoint.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
