#!/usr/bin/env bash
# SENN commit-msg gate (zero-dependency, project-local).
#
# Enforces the Conventional Commits subject-line policy from
# CONTRIBUTING.md / CLAUDE.md §Branch policy.
#
# Allowed types: feat | fix | docs | refactor | test | chore | ci |
#                style | perf | build | revert
# Allowed shapes:
#   <type>: <subject>
#   <type>(<scope>): <subject>
#   <type>!: <subject>            (breaking change)
#   <type>(<scope>)!: <subject>   (breaking change with scope)
#
# `revert: ...` (no scope, generated by `git revert`) is also accepted.
# Merge / fixup / squash / WIP commits are skipped — they get rewritten
# at integration time.
#
# Bypass:
#   git commit --no-verify
#   SENN_SKIP_COMMITMSG=1 git commit ...

set -uo pipefail

if [[ "${SENN_SKIP_COMMITMSG:-}" == "1" ]]; then
  exit 0
fi

msg_file="$1"
if [[ ! -f "$msg_file" ]]; then
  exit 0
fi

# First non-comment, non-empty line is the subject.
subject=""
while IFS= read -r line; do
  case "$line" in
    "#"*) continue ;;
    "")   continue ;;
    *)    subject="$line"; break ;;
  esac
done < "$msg_file"

if [[ -z "$subject" ]]; then
  exit 0  # let git's own empty-message check handle this
fi

# Skip mechanical / WIP commits — they will be rewritten before merge.
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
  "WIP"|"WIP "*|"wip"|"wip "*) exit 0 ;;
esac

# Conventional Commits regex.
# type             — feat|fix|docs|refactor|test|chore|ci|style|perf|build|revert
# (scope)?         — optional, kebab-case-or-letters/numbers/dots/slashes
# !?               — optional breaking-change marker
# : <subject>      — colon, space, non-empty subject
re='^(feat|fix|docs|refactor|test|chore|ci|style|perf|build|revert)(\([a-z0-9._/\-]+\))?!?:[[:space:]].+'

if [[ ! "$subject" =~ $re ]]; then
  echo "[senn commit-msg] subject does not match Conventional Commits:" >&2
  echo "    $subject" >&2
  echo "" >&2
  echo "  Expected one of:" >&2
  echo "    feat: ..."        >&2
  echo "    fix(scope): ..."  >&2
  echo "    docs(adr): ..."   >&2
  echo "    refactor!: ..."   >&2
  echo "" >&2
  echo "  Allowed types: feat fix docs refactor test chore ci style perf build revert" >&2
  echo "  See CLAUDE.md §Branch policy / CONTRIBUTING.md." >&2
  echo "  Bypass (only with reason): git commit --no-verify  or  SENN_SKIP_COMMITMSG=1" >&2
  exit 1
fi

# Subject-length cap (72 chars is the conventional ceiling).
if [[ ${#subject} -gt 72 ]]; then
  echo "[senn commit-msg] subject is ${#subject} chars (max 72):" >&2
  echo "    $subject" >&2
  echo "  Trim the subject and move detail into the body." >&2
  exit 1
fi
